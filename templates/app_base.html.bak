{% extends "base.html" %}
{% block nav %}
<header class="navbar">
  <a class="brand" href="{{ url_for('home') }}">CINE<span>MATRIX</span></a>
  <button class="nav-toggle" aria-label="Menu" aria-expanded="false">☰</button>
  <nav class="nav-links">
    <a href="{{ url_for('home') }}"    class="{{ 'active' if request.endpoint == 'home' }}">Accueil</a>
    <a href="{{ url_for('calculator') }}" class="{{ 'active' if request.endpoint == 'calculator' }}">Calcul n</a>
    <a href="{{ url_for('contact') }}" class="{{ 'active' if request.endpoint == 'contact' }}">Contact</a>
    <a href="{{ url_for('about') }}"   class="{{ 'active' if request.endpoint == 'about' }}">À propos</a>
    <a href="{{ url_for('profile') }}" class="{{ 'active' if request.endpoint == 'profile' }}">Profil</a>
    <form action="{{ url_for('logout') }}" method="post" class="logout-form">
      <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
      <button type="submit" class="btn btn-ghost btn-sm">Déconnexion</button>
    </form>
  </nav>
</header>
{% endblock %}
{% block main_class %}page{% endblock %}
